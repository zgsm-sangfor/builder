      "health_url": "http://localhost:8098/healthz"
    },
    {
      "service_name": "client-manager",
      "component_name": "client-manager",
      "health_url": "http://localhost:8098/healthz"
    },
    {
      "service_name": "code-completion",
      "component_name": "code-completion",
      "health_url": "http://localhost:8099/healthz",
      "log_file": "{{ .COSTRICT_DATA_DIR }}/logs/code-completion.log"
    },
    {
      "service_name": "prometheus",
      "component_name": "prometheus",
      "http_address": "http://{{ .COSTRICT_HOST }}:{{ .PORT_PROMETHEUS }}",
      "health_url": "http://localhost:{{ .PORT_PROMETHEUS }}/healthz"
    },
    {
      "service_name": "grafana",
      "component_name": "grafana",
      "http_address": "http://{{ .COSTRICT_HOST }}:{{ .PORT_GRAFANA }}",
      "health_url": "http://localhost:{{ .PORT_GRAFANA }}/healthz"

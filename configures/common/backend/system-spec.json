      "log_file": "{{ .COSTRICT_DATA_DIR }}/logs/costrict-admin.log"
    },
    {
      "service_name": "etcd",
      "component_name": "etcd",
      "health_url": "http://localhost:32382/health"
    },
    {
      "service_name": "redis",
      "component_name": "redis",
      "health_url": "http://localhost:36379/ping"
    },
    {
      "service_name": "postgres",
      "component_name": "postgres",
      "health_url": "http://localhost:35432/healthz"
    },
    {
      "service_name": "apisix",
      "component_name": "apisix",
      "health_url": "http://localhost:39180/healthz",

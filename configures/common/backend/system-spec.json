{
  "subsystem": "backend",
  "components": [
    {
      "component_name": "costrict-admin-backend",
      "display_name": "costrict-admin后端服务",
      "description": "CoStrict管理服务的后端服务",
      "allowed_versions": ">=1.0.0"
    },
    {
      "component_name": "costrict-admin-frontend",
      "display_name": "costrict-admin前端页面",
      "description": "CoStrict管理服务的前端页面",
      "allowed_versions": ">=1.0.0",
      "dependences": [
        {
          "depend_component": "portal",
          "depend_versions": ">=1.0.0"
        }
      ]
    },
    {
      "component_name": "costrict-license-sdk",
      "display_name": "CoStrict授权服务",
      "description": "CoStrict授权服务",
      "allowed_versions": ">=1.0.0"
    },
    {
      "component_name": "casdoor",
      "display_name": "Casdoor",
      "description": "身份认证和授权平台",
      "allowed_versions": ">=1.0.0",
      "dependences": [
        {
          "depend_component": "postgres",
          "depend_versions": ">=1.0.0"
        }
      ]
    },
    {
      "component_name": "oidc-auth",
      "display_name": "Casdoor认证客户端",
      "description": "Casdoor认证客户端",
      "allowed_versions": ">=1.0.0",
      "dependences": [
        {
          "depend_component": "casdoor",
          "depend_versions": ">=1.0.0"
        }
      ]
    },
    {
      "component_name": "oneapi",
      "display_name": "OneAPI",
      "description": "大语言模型管理服务，聚合多来源多类型大语言模型API",
      "allowed_versions": ">=1.0.0"
    },
    {
      "component_name": "etcd",
      "display_name": "ETCD",
      "description": "分布式键值存储，用于配置管理和服务发现",
      "allowed_versions": ">=3.4.0"
    },
    {
      "component_name": "redis",
      "display_name": "Redis",
      "description": "内存数据结构存储，用作缓存和消息代理",
      "allowed_versions": ">=6.0.0"
    },
    {
      "component_name": "postgres",
      "display_name": "PostgreSQL",
      "description": "关系型数据库，存储业务数据",
      "allowed_versions": ">=13.0.0"
    },
    {
      "component_name": "apisix",
      "display_name": "APISIX",
      "description": "云原生 API 网关，提供 API 网关和负载均衡功能",
      "allowed_versions": ">=2.0.0",
      "dependences": [
        {
          "depend_component": "etcd",
          "depend_versions": ">=1.0.0"
        }
      ]
    },
    {
      "component_name": "portal",
      "display_name": "Portal",
      "description": "前端门户网站服务",
      "allowed_versions": ">=1.0.0"
    },
    {
      "component_name": "chat-rag",
      "display_name": "Chat-RAG",
      "description": "提供基于RAG的聊天和问答服务",
      "allowed_versions": ">=1.0.0"
    },
    {
      "component_name": "credit-manager",
      "display_name": "Credit-Manager",
      "description": "提供用户额度和配额管理功能",
      "allowed_versions": ">=1.0.0"
    },
    {
      "component_name": "code-completion",
      "display_name": "Code-Completion",
      "description": "提供智能代码补全和建议功能",
      "allowed_versions": ">=1.0.0"
    },
    {
      "component_name": "prometheus",
      "display_name": "Prometheus指标监控服务",
      "description": "提供系统监控功能",
      "allowed_versions": ">=1.0.0"
    },
    {
      "component_name": "es",
      "display_name": "ElasticSearch运营数据存储",
      "description": "提供运营数据的采集和存储",
      "allowed_versions": ">=1.0.0"
    },
    {
      "component_name": "grafana",
      "display_name": "Grafana数据可视化服务",
      "description": "提供数据可视化功能",
      "allowed_versions": ">=1.0.0"
    },
    {
      "component_name": "user-indicator",
      "display_name": "用户指标采集服务",
      "description": "采集各个客户端反馈的指标，存储到ES",
      "allowed_versions": ">=0.0.1"
    },
    {
      "component_name": "quota-manager",
      "display_name": "Quota-Manager",
      "description": "提供资源配额和限流管理功能",
      "allowed_versions": ">=1.0.0"
    },
    {
      "component_name": "client-manager",
      "display_name": "Client-Manager",
      "description": "客户端管理支撑服务",
      "allowed_versions": ">=1.0.0"
    }
  ],
  "services": [
    {

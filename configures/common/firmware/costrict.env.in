#-------------------------------------------------------------------------------
# 私有镜像仓库设置
#-------------------------------------------------------------------------------
DH_HOST="docker.io"
DH_ADDR="docker.io/zgsm"

#-------------------------------------------------------------------------------
# 登录神码内部应用所使用的账号密码
#-------------------------------------------------------------------------------
PASSWORD_APISIX_DASHBOARD="{{password 12}}"
PASSWORD_ETCD="{{password 12}}"
PASSWORD_REDIS="{{password 12}}"
PASSWORD_POSTGRES="{{base64 12}}"
PASSWORD_ELASTIC="{{base64 24}}"
PASSWORD_COSTRICT_WEB_DB="{{base64 12}}"
PASSWORD_COSTRICT_WEB_SYSTEM_TOKEN="{{password 16}}"
# costrict-web 新服务（cs-user / workflow）密钥，与 k8s 版本环境变量对应
PASSWORD_COSTRICT_WEB_CS_USER_TOKEN="{{password 16}}"
# CS_BOT_TOKEN_KEY：32 字节密钥 base64 编码后的数据（api/worker 的 team bot token）
PASSWORD_COSTRICT_WEB_CS_BOT_TOKEN="{{gen_n_str_and_base64 32}}"
COSTRICT_WEB_INTERNAL_SECRET="{{password 16}}"
PASSWORD_COSTRICT_WEB_MULTICA_SECRET="{{password 32}}"
PASSWORD_COSTRICT_WEB_JWT_SECRET="{{password 20}}"
PASSWORD_COSTRICT_WEB_CLAWAGENT_ENCRYPTION_KEY="{{password 32}}"
APIKEY_COSTRICT_WEB_DEPT_SYNC_QUERY="{{password 8}}"
NACOS_AUTH_TOKEN="{{base64 64}}"
APIKEY_COSTRICT_DEPT_SYNC_ADMIN="{{password 32}}"
APIKEY_COSTRICT_DEPT_SYNC_DEFAULT="{{password 32}}"
#---------------------------------------------------------
# apisix设置
#---------------------------------------------------------
APIKEY_APISIX_ADMIN="{{base64 32}}"
APIKEY_APISIX_VIEWER="{{base64 32}}"

#-------------------------------------------------------------------------------
# 认证设置(oidc-auth/casdoor)
#-------------------------------------------------------------------------------
# oidc-auth模块在casdoor中注册用的clientid
OIDC_AUTH_CLIENT_ID="9e2fc5d4fbcd52ef4f6f"
# oidc-auth模块在casdoor中注册用的client secret
OIDC_AUTH_CLIENT_SECRET="ab5d8ba28b0e6c0d6e971247cdc1deb269c9eea3"
# apisix使用OIDC协议与casdoor通讯验证请求者身份
OIDC_CLIENT_ID="9e2fc5d4fbcd52ef4f6f"
OIDC_CLIENT_SECRET="ab5d8ba28b0e6c0d6e971247cdc1deb269c9eea3"
OIDC_CASDOOR_ADDR="http://casdoor:8000"
OIDC_DISCOVERY_ADDR="http://casdoor:8000/.well-known/openid-configuration"
OIDC_INTROSPECTION_ENDPOINT="http://casdoor:8000/api/login/oauth/introspect"
OIDC_TOKEN_ENDPOINT=""
#casdoor内建的clientID，原始值：3b215b8c312b0c47ccd7
CASDOOR_BUILTIN_CLIENTID="{{hex 20}}"
#casdoor内建的clientSecret，原始值：e2f78c894cafc828a0b0161059d2c0b8d81deac5
CASDOOR_BUILTIN_CLIENTSECRET="{{hex 40}}"
#-------------------------------------------------------------------------------
# 数据库/Redis/网络设置
#-------------------------------------------------------------------------------
POSTGRES_USER="zgsm"
POSTGRES_DB="zgsm"

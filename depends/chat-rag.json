{
  "name": "chat-rag",
  "type": "github-docker",
  "version": "1.2.8",
  "remote": "https://github.com/zgsm-ai/chat-rag.git",
  "repo": "zgsm",
  "path": "../zgsm-ai/chat-rag",
  "tag": "v{{.version}}",
  "enabled": false,
  "pull": {
    "command": "docker pull {{.repo}}/{{.name}}:v{{.version}}"
  },
  "update": {
    "workdir": "./configures/common/chat-rag",
    "command": "echo IMAGE_CHATRAG={{.repo}}/{{.name}}:v{{.version}} > ./image.env"
  },
  "description": "CHAT service with RAG enhancement capabilities"
}

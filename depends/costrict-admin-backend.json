{
  "name": "costrict-admin-backend",
  "type": "exec",
  "version": "1.0.120",
  "remote": "git@github.com:zgsm-sangfor/costrict-admin.git",
  "repo": "zgsm",
  "path": "../costrict-admin/backend",
  "extras": [
    "../costrict-admin/common"
  ],
  "command": "export DOCKER_BUILDKIT=1 && docker build -f ./Dockerfile --build-arg VERSION={{.version}} .. -t {{.repo}}/{{.name}}:v{{.version}}",
  "tag": "v{{.version}}",
  "component": {
    "workdir": "./configures/common/costrict-admin-backend",
    "command": "echo IMAGE_COSTRICT_ADMIN_BACKEND={{.repo}}/{{.name}}:v{{.version}} > ./image.env"
  },
  "description": "The back-end docker-service of costrict"
}

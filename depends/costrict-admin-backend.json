{
  "name": "costrict-admin-backend",
  "repo": "zgsm",
  "version": "1.0.89",
  "type": "exec",
  "path": "../../costrict-admin/backend",
  "command": "docker build --build-arg VERSION={{.version}} . -t {{.repo}}/{{.name}}:v{{.version}}",
  "tag": "v{{.version}}",
  "component": {
    "workdir": "./configures/common/costrict-admin-backend",
    "command": "echo IMAGE_COSTRICT_ADMIN_BACKEND={{.repo}}/{{.name}}:v{{.version}} > ./image.env"
  },
  "description": "The back-end docker-service of costrict"
}

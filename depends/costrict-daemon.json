{
  "name": "costrict-daemon",
  "type": "exec",
  "remote": "git@github.com:zgsm-sangfor/costrict-admin.git",
  "path": "../costrict-admin",
  "sources": [
    "../costrict-admin/daemon",
    "../costrict-admin/common"
  ],
  "platforms": [
    {
      "os": "linux",
      "arch": "amd64"
    }
  ],
  "build": {
    "workdir": "../costrict-admin/daemon"
  },
  "pull": {
    "workdir": ".",
    "command": "./github-fetch-release.sh --package costrict-daemon --repo zgsm-sangfor/costrict-admin --os {{os}} --arch {{arch}} --version {{.version}} --output {{output}}"
  },
  "version": "1.0.137",
  "description": "The daemon of costrict"
}

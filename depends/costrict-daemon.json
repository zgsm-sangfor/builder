{
  "name": "costrict-daemon",
  "type": "exec",
  "remote": "git@github.com:zgsm-sangfor/costrict-admin.git",
  "path": "../costrict-admin",
  "sources": [
    "../costrict-admin/daemon",
    "../costrict-admin/common"
  ],
  "platforms": [
    {
      "os": "linux",
      "arch": "amd64"
    }
  ],
  "build": {
    "workdir": "../costrict-admin/daemon"
  },
  "pull": {
    "command": "mkdir -p ../packages/costrict-daemon/{{.os}}/{{.arch}}/{{.version}} && curl -fSL -o ../packages/costrict-daemon/{{.os}}/{{.arch}}/{{.version}}/costrict-daemon https://github.com/zgsm-sangfor/costrict-admin/releases/download/v{{.version}}/costrict-daemon-{{.os}}-{{.arch}}-v{{.version}}"
  },
  "version": "1.0.139",
  "description": "The daemon of costrict"
}

{
  "name": "costrict-daemon",
  "type": "exec",
  "remote": "git@github.com:zgsm-sangfor/costrict-admin.git",
  "path": "../costrict-admin",
  "sources": [
    "../costrict-admin/daemon",
    "../costrict-admin/common"
  ],
  "platforms": [
    {
      "os": "linux",
      "arch": "amd64"
    },
    {
      "os": "linux",
      "arch": "arm64"
    }
  ],
  "build": {
    "workdir": "../costrict-admin/daemon"
  },
  "pull": {
    "workdir": ".",
    "command": "github-fetch-release.sh --repo zgsm-sangfor/costrict-admin --package costrict-daemon --os {{os}} --arch {{arch}} --version {{.version}}"
  },
  "version": "1.0.138",
  "description": "The daemon of costrict"
}

{
  "name": "costrict-admin",
  "type": "github",
  "remote": "git@github.com:zgsm-sangfor/costrict-admin.git",
  "path": "../costrict-admin",
  "sources": [
    "../costrict-admin/utility",
    "../costrict-admin/common"
  ],
  "platforms": [
    {
      "os": "linux",
      "arch": "amd64"
    },
    {
      "os": "windows",
      "arch": "amd64"
    }
  ],
  "build": {
    "workdir": "../costrict-admin/utility"
  },
  "pull": {
    "command": "./github-fetch-release.sh --package costrict-admin --os {{os}} --arch {{arch}} --version {{.version}}"
  },
  "version": "1.0.137",
  "description": "Utilities for backend management of Costrict"
}

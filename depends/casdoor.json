{
  "name": "casdoor",
  "type": "exec",
  "version": "2.2.1",
  "repo": "zgsm",
  "path": "../../source/casdoor",
  "command": "docker build --build-arg VERSION={{.version}} . -t {{.repo}}/{{.name}}:v{{.version}}",
  "tag": "v{{.version}}",
  "enabled": false,
  "component": {
    "workdir": "./configures/common/casdoor",
    "command": "echo IMAGE_CASDOOR={{.repo}}/{{.name}}:v{{.version}} > ./image.env"
  },
  "description": "User Authentication Management System"
}

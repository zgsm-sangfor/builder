{
  "name": "casdoor",
  "type": "github-docker",
  "version": "2.2.5",
  "repo": "zgsm",
  "remote": "git@github.com:zgsm-sangfor/casdoor.git",
  "path": "../zgsm-ai/casdoor",
  "tag": "v{{.version}}",
  "pull": {
    "command": "docker-pull-via.sh --proxy-id ghcr.io/zgsm-sangfor/{{.name}}:{{.tag}} --image-id  {{.repo}}/{{.name}}:v{{.version}}"
  },
  "update": {
    "workdir": "./configures/common/casdoor",
    "command": "echo IMAGE_CASDOOR={{.repo}}/{{.name}}:v{{.version}} > ./image.env"
  },
  "enabled": false,
  "description": "User Authentication Management System"
}

{
  "name": "costrict-model-proxy",
  "type": "github-docker",
  "version": "0.0.4",
  "remote": "git@github.com:zgsm-sangfor/costrict-model-proxy.git",
  "repo": "ghcr.io/zgsm-sangfor",
  "tag": "v{{.version}}",
  "path": "../zgsm-ai/costrict-model-proxy",
  "command": "docker build --build-arg VERSION={{.version}} . -t {{.repo}}/{{.name}}:v{{.version}}",
  "build": {
    "workdir": "../zgsm-ai/costrict-model-proxy",
    "command": "docker build --build-arg VERSION={{.version}} . -t {{.repo}}/{{.name}}:v{{.version}}"
  },
  "pull": {
    "command": "docker pull ghcr.io/zgsm-sangfor/costrict-model-proxy:v{{.version}}"
  },
  "update": {
    "workdir": "./configures/common/costrict-model-proxy",
    "command": "echo IMAGE_COSTRICT_MODEL_PROXY=ghcr.io/zgsm-sangfor/costrict-model-proxy:v{{.version}} > ./image.env"
  }
}

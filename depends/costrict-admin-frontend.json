{
  "name": "costrict-admin-frontend",
  "type": "docker",
  "version": "1.0.189",
  "remote": "git@github.com:zgsm-sangfor/costrict-admin.git",
  "path": "../SLA/costrict-admin",
  "repo": "ghcr.io/zgsm-sangfor",
  "tag": "v{{.version}}",
  "enabled": true,
  "sources": [
    "../SLA/costrict-admin/frontend"
  ],
  "excludes": [
    "*/dist/*",
    "*/.git/*",
    "*/node_modules/*"
  ],
  "build": {
    "workdir": "../SLA/costrict-admin/frontend",
    "command": "export DOCKER_BUILDKIT=1 && docker build -f ./Dockerfile --build-arg VERSION={{.version}} .. -t {{.repo}}/{{.name}}:{{.tag}}"
  },
  "pull": {
    "workdir": "../SLA/costrict-admin/frontend",
    "command": "docker-pull-via.sh --proxy-id ghcr.io/zgsm-sangfor/{{.name}}:{{.tag}} --image-id  {{.repo}}/{{.name}}:{{.tag}}"
  },
  "update": {
    "workdir": "./configures/common/costrict-admin-frontend",
    "command": "echo IMAGE_COSTRICT_ADMIN_FRONTEND={{.repo}}/{{.name}}:{{.tag}} > ./image.env"
  },
  "description": "Build the front-end page to be released for the costrict system."
}

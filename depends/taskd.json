{
  "name": "taskd",
  "type": "docker",
  "version": "1.0.3",
  "remote": "git@github.com:zgsm-ai/taskd.git",
  "repo": "zgsm",
  "path": "../services/taskd",
  "command": "docker build --build-arg VERSION={{.version}} . -t {{.repo}}/{{.name}}:v{{.version}}",
  "tag": "v{{.version}}",
  "enabled": false,
  "build": {
    "command": "export DOCKER_BUILDKIT=1 && docker build -f ./Dockerfile --build-arg VERSION={{.version}} .. -t {{.repo}}/{{.name}}:v{{.version}}"
  },
  "pull": {
    "command": "docker pull {{.repo}}/{{.name}}:v{{.version}}"
  },
  "update": {
    "workdir": "./configures/common/taskd",
    "command": "echo IMAGE_TASKD={{.repo}}/{{.name}}:v{{.version}} > ./image.env"
  },
  "description": "Task management service"
}

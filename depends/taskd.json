{
  "name": "taskd",
  "type": "exec",
  "version": "1.0.3",
  "repo": "zgsm",
  "path": "../../services/taskd",
  "command": "docker build --build-arg VERSION={{.version}} . -t {{.repo}}/{{.name}}:v{{.version}}",
  "tag": "v{{.version}}",
  "enabled": false,
  "component": {
    "workdir": "./configures/common/taskd",
    "command": "echo IMAGE_TASKD={{.repo}}/{{.name}}:v{{.version}} > ./image.env"
  },
  "description": "Task management service"
}

{
  "name": "one-api",
  "type": "exec",
  "version": "1.0.4",
  "repo": "zgsm",
  "path": "../../source/new-api",
  "command": "docker build --build-arg VERSION={{.version}} . -t {{.repo}}/{{.name}}:v{{.version}}",
  "tag": "v{{.version}}",
  "enabled": false,
  "component": {
    "workdir": "./configures/common/oneapi",
    "command": "echo IMAGE_ONEAPI={{.repo}}/{{.name}}:v{{.version}} > ./image.env"
  },
  "description": "LLM Management Gateway Service"
}
{
  "name": "one-api",
  "type": "github-docker",
  "version": "0.11.2",
  "remote": "git@github.com:zgsm-sangfor/one-api.git",
  "path": "../source/new-api",
  "repo": "zgsm",
  "tag": "v{{.version}}",
  "image": "{{.repo}}/{{.name}}:v{{.version}}",
  "build": {
    "command": "export DOCKER_BUILDKIT=1 && docker build -f ./Dockerfile --build-arg VERSION={{.version}} .. -t {{.repo}}/{{.name}}:v{{.version}}"
  },
  "pull": {
    "command": "./docker-pull-via.sh --image-id {{.repo}}/{{.name}}:v{{.version}} --proxy-id hub.dbin.site/{{.repo}}/{{.name}}:v{{.version}}"
  },
  "update": {
    "workdir": "./configures/common/oneapi",
    "command": "echo IMAGE_ONEAPI={{.repo}}/{{.name}}:v{{.version}} > ./image.env"
  },
  "enabled": false,
  "description": "LLM Management Gateway Service"
}

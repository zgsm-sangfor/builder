{
  "name": "costrict-authd-frontend",
  "version": "1.0.0",
  "type": "frontend",
  "remote": "git@github.com:zgsm-sangfor/authd.git",
  "path": "../authd",
  "command": "bash build.sh",
  "sources": [
    "../costrict-admin/frontend"
  ],
  "excludes": [
    "*/dist/*",
    "*/.git/*",
    "*/node_modules/*"
  ],
  "build": {
    "workdir": "../authd/frontend",
    "command": "bash build.sh"
  },
  "pull": {
    "workdir": "../authd/frontend",
    "command": "bash build.sh"
  },
  "update": {
    "workdir": "../authd/frontend",
    "command": "bash update.sh"
  }
}

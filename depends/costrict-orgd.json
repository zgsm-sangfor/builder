{
  "name": "costrict-orgd",
  "type": "docker",
  "version": "0.4.7",
  "remote": "git@github.com:zgsm-sangfor/authd.git",
  "repo": "zgsm-sangfor",
  "path": "../authd",
  "sources": [
    "../authd/orgd"
  ],
  "tag": "v{{.version}}",
  "build": {
    "workdir": "../authd/orgd",
    "command": "export DOCKER_BUILDKIT=1 && docker build -f ./Dockerfile --build-arg VERSION={{.version}} .. -t {{.repo}}/orgd:v{{.version}}"
  },
  "pull": {
    "command": "docker-pull-via.sh --proxy-id ghcr.io/zgsm-sangfor/orgd:{{.tag}} --image-id  {{.repo}}/orgd:v{{.version}}"
  },
  "update": {
    "workdir": "./configures/common/costrict-orgd",
    "command": "echo IMAGE_COSTRICT_AUTHZ={{.repo}}/orgd:v{{.version}} > ./image.env"
  },
  "description": "The orgd of costrict"
}

{
  "name": "cotun",
  "repo": "zgsm",
  "version": "1.3.13",
  "type": "exec",
  "path": "../../services/cotun",
  "command": "docker build --build-arg VERSION={{.version}} . -t {{.repo}}/{{.name}}:v{{.version}}",
  "tag": "v{{.version}}",
  "component": {
    "workdir": "./configures/common/cotund",
    "command": "echo IMAGE_COTUN={{.repo}}/{{.name}}:v{{.version}} > ./image.env"
  },
  "description": "Stream transfer tools"
}

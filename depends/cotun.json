{
  "name": "cotun",
  "type": "github-docker",
  "version": "1.3.13",
  "remote": "git@github.com:zgsm-sangfor/cotun.git",
  "repo": "zgsm",
  "path": "../services/cotun",
  "tag": "v{{.version}}",
  "build": {
    "command": "export DOCKER_BUILDKIT=1 && docker build -f ./Dockerfile --build-arg VERSION={{.version}} . -t {{.repo}}/{{.name}}:v{{.version}}"
  },
  "pull": {
    "command": "docker pull {{.repo}}/{{.name}}:v{{.version}}"
  },
  "update": {
    "workdir": "./configures/common/cotund",
    "command": "echo IMAGE_COTUN={{.repo}}/{{.name}}:v{{.version}} > ./image.env"
  },
  "enabled": false,
  "description": "Stream transfer tools"
}

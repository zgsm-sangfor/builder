{
  "name": "cotun",
  "type": "github",
  "version": "1.3.13",
  "remote": "git@github.com:zgsm-sangfor/cotun.git",
  "repo": "zgsm",
  "path": "../services/cotun",
  "command": "docker pull {{.repo}}/{{.name}}:v{{.version}}",
  "tag": "v{{.version}}",
  "component": {
    "workdir": "./configures/common/cotund",
    "command": "echo IMAGE_COTUN={{.repo}}/{{.name}}:v{{.version}} > ./image.env"
  },
  "enabled": false,
  "description": "Stream transfer tools"
}

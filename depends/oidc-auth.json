{
  "name": "oidc-auth",
  "type": "github",
  "version": "1.3.1",
  "remote": "git@github.com:zgsm-sangfor/oidc-auth.git",
  "repo": "zgsm",
  "path": "../zgsm-ai/oidc-auth",
  "tag": "v{{.version}}",
  "enabled": true,
  "build": {
    "command": "docker build --build-arg VERSION={{.version}} . -t {{.repo}}/{{.name}}:v{{.version}}"
  },
  "pull": {
    "command": "docker pull {{.repo}}/{{.name}}:v{{.version}}"
  },
  "update": {
    "workdir": "./configures/common/oidc-auth",
    "command": "echo IMAGE_OIDC_AUTH={{.repo}}/{{.name}}:v{{.version}} > ./image.env"
  },
  "description": "Casdoor Authentication Client"
}

{
  "name": "orgd",
  "type": "docker",
  "version": "0.4.8",
  "remote": "git@github.com:zgsm-sangfor/authd.git",
  "repo": "zgsm",
  "path": "../authd",
  "sources": [
    "../authd/orgd"
  ],
  "tag": "v{{.version}}",
  "build": {
    "workdir": "../authd/orgd",
    "command": "export DOCKER_BUILDKIT=1 && docker build -f ./Dockerfile --build-arg VERSION={{.version}} .. -t {{.repo}}/{{.name}}:{{.tag}}"
  },
  "pull": {
    "command": "docker-pull-via.sh --proxy-id ghcr.io/zgsm-sangfor/{{.name}}:{{.tag}} --image-id  {{.repo}}/{{.name}}:{{.tag}}"
  },
  "update": {
    "workdir": "./configures/common/orgd",
    "command": "echo IMAGE_ORGD={{.repo}}/{{.name}}:{{.tag}} > ./image.env"
  },
  "description": "The orgd of costrict"
}

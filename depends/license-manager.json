{
  "name": "license-manager",
  "type": "exec",
  "version": "1.0.4",
  "repo": "zgsm",
  "path": "../license",
  "command": "docker build -f manager.Dockerfile --build-arg VERSION={{.version}} . -t {{.repo}}/{{.name}}:v{{.version}}",
  "tag": "v{{.version}}",
  "component": {
    "workdir": "./configures/common/license-manager",
    "command": "echo IMAGE_LICENSE_MANAGER={{.repo}}/{{.name}}:v{{.version}} > ./image.env"
  }
}

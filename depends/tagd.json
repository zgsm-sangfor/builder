{
  "name": "tagd",
  "type": "exec",
  "version": "1.0.4",
  "remote": "git@github.com:zgsm-ai/tagd.git",
  "repo": "zgsm",
  "path": "../services/tagd",
  "tag": "v{{.version}}",
  "enabled": false,
  "build": {
    "command": "export DOCKER_BUILDKIT=1 && docker build -f ./Dockerfile --build-arg VERSION={{.version}} .. -t {{.repo}}/{{.name}}:v{{.version}}"
  },
  "pull": {
    "command": "docker pull {{.repo}}/{{.name}}:v{{.version}}"
  },
  "update": {
    "workdir": "./configures/common/tagd",
    "command": "echo IMAGE_TAGD={{.repo}}/{{.name}}:v{{.version}} > ./image.env"
  },
  "description": "Tag management service"
}
